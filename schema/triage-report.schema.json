{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TriageReport",
  "description": "Agent 与 Skill 运行时排障输出：问题分类、证据、根因、修复建议与回归步骤",
  "type": "object",
  "required": ["mode", "verdict", "category", "summary", "findings", "rootCause", "fixes", "regression"],
  "properties": {
    "mode": { "type": "string", "enum": ["drift", "engine", "mcp", "loop"] },
    "verdict": { "type": "string", "enum": ["pass", "fail"] },
    "category": {
      "type": "string",
      "enum": ["Skill 行为漂移", "跨引擎不一致", "MCP 调用失败", "Agent 死循环"]
    },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "description": "证据列表，每条都要能定位到用例、步骤、端口或变量",
      "items": {
        "type": "object",
        "required": ["level", "title"],
        "properties": {
          "level": { "type": "string", "enum": ["fail", "warn"] },
          "title": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "rootCause": {
      "type": "array",
      "description": "按可能性排序的根因候选",
      "items": { "type": "string" }
    },
    "fixes": {
      "type": "array",
      "description": "修复建议，按执行顺序排列",
      "items": { "type": "string" }
    },
    "regression": {
      "type": "array",
      "description": "回归验证步骤与通过标准",
      "items": { "type": "string" }
    }
  }
}
